---
import ResumeLayout from '../../../layouts/ResumeLayout.astro';
import { meta, ui, profiles, services, type Lang, type ProfileId } from '../../../data/resume';

export function getStaticPaths() {
  const langs = ['es', 'ca', 'en'] as const;
  const pages = ['about', 'services', 'contact', 'shop', 'logistica', 'fullstack', 'generico'] as const;
  return langs.flatMap((lang) => pages.map((page) => ({ params: { lang, page } })));
}

const { lang, page } = Astro.params as { lang: Lang; page: string };
const t = ui[lang];
const profileIds: ProfileId[] = ['logistica', 'fullstack', 'generico'];
const isProfile = profileIds.includes(page as ProfileId);

if (page === 'about' || page === 'shop') {
  return Astro.redirect(`/resume/${lang}/`, 301);
}

const prefix = `/resume/${lang}/`;
const profile = isProfile ? profiles[page as ProfileId][lang] : null;
const pageTitle = isProfile ? profile!.title : page === 'services' ? t.servicesTitle : t.contactTitle;
const whatsappUrl = `https://wa.me/${meta.whatsapp}?text=${encodeURIComponent(t.whatsappPrefill)}`;
---

<ResumeLayout
  title={pageTitle}
  lang={lang}
  path={`${page}/`}
  active={isProfile ? 'profile' : (page as 'services' | 'contact')}
>
  {page === 'services' && (
    <section class="section">
      <div class="container">
        <p class="hero-eyebrow">{t.servicesSubtitle}</p>
        <h1 class="hero-title" style="font-size:clamp(1.9rem,4vw,2.6rem);margin-bottom:.75rem">{t.servicesTitle}</h1>
        <p class="section-sub" style="max-width:42rem">{t.servicesIntro}</p>

        <div class="card-grid" style="margin-top:2.5rem">
          {services[lang].map((service) => (
            <article class="card reveal">
              <h2 class="card-title">{service.title}</h2>
              <p class="entry-desc" style="margin-top:.5rem;margin-bottom:0">{service.description}</p>
            </article>
          ))}
        </div>

        <div class="cta-panel reveal" style="margin-top:3rem">
          <p class="cta-text">{t.contactSubtitle}</p>
          <div class="cta-actions">
            <a href={`${prefix}contact/`} class="btn btn-primary"><svg class="icon icon-lg"><use href="#i-mail" /></svg>{t.nav.contact}</a>
            <a href={`${prefix}`} class="btn btn-outline"><svg class="icon icon-lg"><use href="#i-arrow-right" /></svg>{t.nav.cv}</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {page === 'contact' && (
    <section class="section">
      <div class="container">
        <p class="hero-eyebrow">{t.contactSubtitle}</p>
        <h1 class="hero-title" style="font-size:clamp(1.9rem,4vw,2.6rem);margin-bottom:.75rem">{t.contactTitle}</h1>
        <p class="section-sub" style="max-width:42rem">{t.contactIntro}</p>

        <div class="contact-grid" style="margin-top:2.5rem">
          <div class="contact-list reveal">
            <a href={`mailto:${meta.email}`} class="contact-item">
              <svg class="icon"><use href="#i-mail" /></svg>{meta.email}
            </a>
            <a href={`tel:${meta.phone.replace(/\s/g, '')}`} class="contact-item">
              <svg class="icon"><use href="#i-phone" /></svg>{meta.phone}
            </a>
            <span class="contact-item">
              <svg class="icon"><use href="#i-map-pin" /></svg>{meta.location}
            </span>
            <a href={meta.linkedin} target="_blank" rel="noopener" class="contact-item">
              <svg class="icon"><use href="#i-linkedin" /></svg>LinkedIn
            </a>
            <a href={meta.github} target="_blank" rel="noopener" class="contact-item">
              <svg class="icon"><use href="#i-github" /></svg>GitHub
            </a>
            <a href={whatsappUrl} target="_blank" rel="noopener" class="contact-item">
              <svg class="icon"><use href="#i-message-circle" /></svg>{t.whatsappCta} · {t.whatsappSub}
            </a>
          </div>

          <form class="form reveal" action={`mailto:${meta.email}`} method="POST" enctype="text/plain">
            <p class="section-sub" style="margin-bottom:0">{t.orWrite}</p>
            <input name="nombre" placeholder={t.formName} required />
            <input name="email" type="email" placeholder={t.formEmail} required />
            <textarea name="mensaje" placeholder={t.formMsg} rows="5" required></textarea>
            <button type="submit" class="btn btn-primary">{t.send}</button>
          </form>
        </div>
      </div>
    </section>
  )}

  {profile && (
    <section class="section">
      <div class="container narrow">
        <p class="hero-eyebrow">{meta.name} · {meta.location}</p>
        <h1 class="hero-title" style="font-size:clamp(1.9rem,4vw,2.6rem);margin-bottom:.5rem">{profile.title}</h1>
        <p class="hero-role">{profile.role}</p>
        <p class="section-sub">{profile.description}</p>

        <h2 class="section-title reveal">
          <svg class="icon icon-xl"><use href="#i-user" /></svg>
          {t.sectionProfile}
        </h2>
        <p class="lead reveal">{profile.about}</p>

        <h2 class="section-title reveal" style="margin-top:3rem">
          <svg class="icon icon-xl"><use href="#i-sparkles" /></svg>
          {t.profileSkills}
        </h2>
        <div class="lang-chips reveal">
          {profile.skills.map((skill) => <span class="pill">{skill}</span>)}
        </div>

        <h2 class="section-title reveal" style="margin-top:3rem">
          <svg class="icon icon-xl"><use href="#i-briefcase" /></svg>
          {t.profileExperience}
        </h2>
        <div class="timeline">
          {profile.experience.map((exp) => (
            <article class="timeline-item reveal">
              <span class="timeline-dot" />
              <div class="entry">
                <div class="entry-head">
                  <h3 class="entry-role">{exp.role}</h3>
                  <span class="entry-period">{exp.period}</span>
                </div>
                <p class="entry-company">{exp.company}</p>
                <ul class="entry-list">
                  {exp.highlights.map((item) => (
                    <li><svg class="icon accent-teal mt"><use href="#i-check" /></svg><span>{item}</span></li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>

        <div class="hero-actions reveal" style="margin-top:3rem">
          <a href={`${prefix}`} class="btn btn-outline"><svg class="icon icon-lg"><use href="#i-arrow-right" /></svg>{t.backToCv}</a>
          <a href={`mailto:${meta.email}`} class="btn btn-primary"><svg class="icon icon-lg"><use href="#i-mail" /></svg>{t.profileContact}</a>
          <a href={meta.pdfUrl} download="CV_sergio-jurado.pdf" class="btn btn-ghost"><svg class="icon icon-lg"><use href="#i-download" /></svg>{t.downloadPdf}</a>
        </div>
      </div>
    </section>
  )}
</ResumeLayout>
